{
  "name": "life-crossroads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4173 --strictPort",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "preview": "npm run build && npm start",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node --test src/game/*.test.ts src/lib/*.test.ts src/simulation/*.test.ts src/pixel/*.test.ts server/*.test.mjs",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
