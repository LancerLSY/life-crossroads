# Copy to .env at the project root. Keep .env private; never prefix secrets with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: require this bearer token for model-backed actions on shared servers.
# Enter the same token in the game's settings; it stays in browser session memory.
GAME_ACCESS_TOKEN=
# If HTTPS terminates at a reverse proxy, set this to the game's exact public origin.
# Example: https://life.example.com (no trailing path).
GAME_PUBLIC_ORIGIN=

HOST=127.0.0.1
PORT=3001
MODEL_TIMEOUT_MS=20000
GAME_RATE_LIMIT=30
GAME_MAX_CONCURRENT=4
